# ─── LLM (OpenRouter) ────────────────────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=1600

# ─── Supabase (optional, for chat history + exploration analytics) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── NASA Earthdata (optional, only for the ETL / future adapters) ───
EARTHDATA_API_KEY=your-earthdata-api-key
EARTHDATA_TOKEN=your-earthdata-token

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/k2
NEXT_PUBLIC_TEAM_URL=https://www.spaceappschallenge.org/2026/find-a-team/2317/?tab=members

# ─── Vercel CLI (optional) ───────────────────────────────────────────
VERCEL_TOKEN=your-vercel-token
